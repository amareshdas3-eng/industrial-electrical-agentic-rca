# =====================================================================
# Industrial Electrical SLD Multi-Agent RCA Engine - Configuration
# =====================================================================

# Optional: Set either key for Gemini or OpenAI LLM reasoning.
# If omitted, the system automatically runs the built-in offline IEEE C37.2 / IEC 60255 expert model.
GEMINI_API_KEY=
OPENAI_API_KEY=

# Local Server Settings
BACKEND_PORT=8001
FRONTEND_PORT=3000

# Optional: Neo4j Graph Database Settings
# (If offline, system automatically utilizes scripts/sld_graph_cache.json)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password
